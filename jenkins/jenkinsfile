pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/michelameanto/SomeBankingApp.git'
            }
        }
        stage('Build Backend') {
            steps {
                sh 'docker build -t banking-backend ./backend'
            }
        }
        stage('Build Frontend') {
            steps {
                sh 'docker build -t banking-frontend ./frontend'
            }
        }
    }
}